# Facebook Page (required for live posting)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v22.0

# immediate | schedule | dry_run
# immediate = post the second news is detected (recommended for breaking news)
# schedule  = Facebook scheduled post (minimum +10 minutes)
PUBLISH_MODE=immediate
SCHEDULE_DELAY_MINUTES=10

# Polling
POLL_INTERVAL_SECONDS=60
MAX_AGE_HOURS=6
MAX_POSTS_PER_CYCLE=3

# Storage
DATABASE_PATH=data/seen_articles.db

# Post copy
HASHTAGS=#Arsenal #AFC #COYG #Gunners
INCLUDE_LINK=true
POST_PREFIX=🔴 Arsenal News

# Optional LLM rewrite (OpenAI-compatible)
USE_LLM_REWRITE=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
