NEXT_PUBLIC_SITE_URL=https://quiz.mediareferee.com
# AdSense (preferred on quiz while Ezoic JS is blocked). Do not enable together with Ezoic.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-3795330167795048
# Optional display unit from AdSense → Ads → By ad unit:
# NEXT_PUBLIC_ADSENSE_SLOT=
NEXT_PUBLIC_EZOIC_ADS=true
# Optional override. Default matches live mediareferee.com/ads.txt
# (https://srv.adstxtmanager.com/85097/mediareferee.com).
# EZOIC_ADS_TXT_URL=
# Google Analytics 4 Measurement ID (from GA4 Admin → Data Streams → Web):
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Cloud Vertex AI (Imagen 3) for Quiz Artwork Generation
# GCP Project ID (Vertex AI API must be enabled)
GCP_PROJECT_ID=
# GCP Region / Location (default: us-central1)
GCP_REGION=us-central1
# Optional: Path to service account key JSON file. If omitted, Google Auth uses Application Default Credentials (gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# Paddle Billing v2 Configuration
# Environment: "production" (for live) or "sandbox" (for testing) — REQUIRED, fails loudly if unset
NEXT_PUBLIC_PADDLE_ENV=production

# Client-side token (Paddle -> Developer tools -> Authentication)
# Prefix starts with live_ for production, or test_ for sandbox — REQUIRED
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Lampstand Pro Price IDs (Catalog -> Products & Prices)
NEXT_PUBLIC_PADDLE_MONTHLY_PRICE_ID=pri_01m3491eqp91gkse1fmpngdt7h
NEXT_PUBLIC_PADDLE_ANNUAL_PRICE_ID=pri_01m3491f04x6epgafayhm6saty

# Optional: Starter & Advanced Price IDs (leave blank for default/custom handling)
NEXT_PUBLIC_PADDLE_STARTER_MONTHLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_STARTER_ANNUAL_PRICE_ID=
NEXT_PUBLIC_PADDLE_ADVANCED_MONTHLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_ADVANCED_ANNUAL_PRICE_ID=

# Server-side API key (Paddle -> Developer tools -> Authentication) — NEVER expose to client
PADDLE_API_KEY=

# Notification webhook destination secret (Paddle -> Developer tools -> Notifications)
PADDLE_NOTIFICATION_WEBHOOK_SECRET=

